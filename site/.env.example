# Copy this file to .env and fill in your real keys, then restart: node server.js
# .env is gitignored — your keys never get committed or sent anywhere but Tavily/OpenRouter.

TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to google/gemini-3-flash-preview if omitted
OPENROUTER_MODEL=google/gemini-3-flash-preview
